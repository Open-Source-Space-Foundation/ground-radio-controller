/*
 * Project-specific hardware for PROVES Flight Control Board v5e.
 * Same wiring intent as the v5 port, but the v5e carries an SX126x-based
 * LoRa module (E22-400M30S) instead of the v5's SX1276.
 *
 * Phase 6 (USP port): the SX1262 node now uses the USP "semtech,sx1262-new"
 * binding instead of the in-tree Zephyr "semtech,sx1262" binding, so that
 * CONFIG_LORA_BASICS_MODEM_DRIVERS (usp_zephyr) claims the device instead of
 * the in-tree loramac-node driver (LORA_BASICS_MODEM_DRIVERS depends on
 * !LORA, so exactly one driver binds). Node/property mapping mirrors
 * proves-core-reference's v5e USP node (same module, same wiring -- GRC's
 * v5e board was itself ported *from* flight's v5e pinout).
 */

#include <zephyr/dt-bindings/usp/sx126x.h>

&zephyr_udc0 {
	/* Control port */
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
	/* Data port */
	cdc_acm_uart1: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&pinctrl {
	spi1_default: spi1_default {
		group1 {
			pinmux = <SPI1_SCK_P10>, <SPI1_TX_P11>;
		};

		group2 {
			pinmux = <SPI1_RX_P12>;
			input-enable;
		};
	};
};

&spi1 {
	status = "okay";
	cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi1_default>;
	pinctrl-names = "default";

	/*
	 * USP SX1262 node -- E22-400M30S module, SPI1 CS0.
	 *
	 * compatible: "semtech,sx1262-new" (USP binding) instead of the
	 *   in-tree "semtech,sx1262" -- prevents the in-tree Zephyr lora
	 *   driver from claiming this device.
	 * dio1-gpios: GPIO_PULL_DOWN moved here from tx/rx-enable-gpios
	 *   (matches flight's v5e USP node -- a real diff introduced during
	 *   flight's port, carried over rather than the stale in-tree flags).
	 * dio3-as-tcxo-control + tcxo-voltage: replaces dio3-tcxo-voltage.
	 * tcxo-wakeup-time: replaces tcxo-power-startup-delay-ms.
	 * reg-mode: new required USP property; LDO on E22-400M30S (no DC-DC
	 *   inductor).
	 */
	lora0_usp: sx1262_usp@0 {
		compatible = "semtech,sx1262-new";
		reg = <0>;
		spi-max-frequency = <125000>;
		reset-gpios  = <&gpio0 6  GPIO_ACTIVE_LOW>;
		busy-gpios   = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		dio1-gpios   = <&gpio0 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		dio3-as-tcxo-control;
		tcxo-voltage     = <SX126X_TCXO_SUPPLY_1_8V>;
		tcxo-wakeup-time = <10>;
		reg-mode         = <SX126X_REG_MODE_LDO>;
		rx-boosted;
		tx-enable-gpios  = <&gpio0 21 GPIO_ACTIVE_HIGH>;
		rx-enable-gpios  = <&gpio0 22 GPIO_ACTIVE_HIGH>;
		label = "E22-400M30S";
	};
};

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		/*
		 * smtc_sw_platform_helper.c calls
		 * DEVICE_DT_GET(DT_CHOSEN(zephyr_lorawan_transceiver)) to obtain
		 * the ral_t* handle for the SX1262 -- required for the USP path.
		 */
		zephyr,lorawan-transceiver = &lora0_usp;
	};

	fstab {
		compatible = "zephyr,fstab";
		ffs1: ffs1 {
			compatible = "zephyr,fstab,fatfs";
			disk-access;
			automount;
			mount-point = "/";
		};
	};

	ramdisk0 {
		compatible = "zephyr,ram-disk";
		disk-name = "RAM";
		sector-size = <512>;
		sector-count = <128>;
	};
};
