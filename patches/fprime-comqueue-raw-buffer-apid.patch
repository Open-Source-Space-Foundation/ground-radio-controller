+void ComQueueTester ::testRawFrameApid() {
+    // A relay queues raw radio frames: their leading bytes are a frame header, not an APID.
+    U8 rawFrame[] = {0x20, 0x44, 0x04, 0xf7, 0x00, 0x78, 0x78};  // CCSDS TC frame header
+    U8 telemPacket[] = {0x00, 0x01, 0xad, 0xbe};                  // FW_PACKET_TELEM
+    Fw::Buffer rawBuffer(rawFrame, sizeof(rawFrame));
+    Fw::Buffer telemBuffer(telemPacket, sizeof(telemPacket));
+    Fw::ComBuffer rawComBuffer(rawFrame, sizeof(rawFrame));
+    configure();
+
+    invoke_to_bufferQueueIn(0, rawBuffer);
+    emitOne();
+    ASSERT_EQ(ComCfg::Apid::FW_PACKET_UNKNOWN, this->fromPortHistory_dataOut->at(0).context.get_apid());
+    ASSERT_EQ(sizeof(rawFrame), this->fromPortHistory_dataOut->at(0).data.getSize());
+
+    invoke_to_bufferQueueIn(0, telemBuffer);
+    emitOne();
+    ASSERT_EQ(ComCfg::Apid::FW_PACKET_TELEM, this->fromPortHistory_dataOut->at(1).context.get_apid());
+
+    invoke_to_comPacketQueueIn(0, rawComBuffer, 0);
+    emitOne();
+    ASSERT_EQ(ComCfg::Apid::FW_PACKET_UNKNOWN, this->fromPortHistory_dataOut->at(2).context.get_apid());
+
+    clearFromPortHistory();
+    component.cleanup();
+}
