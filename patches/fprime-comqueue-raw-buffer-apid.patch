 namespace Svc {

+namespace {
+//! APID for a queued buffer, taken from its first bytes. A queued buffer need not be an F Prime packet:
+//! a relay forwards whole radio frames, which start with a frame header (version and spacecraft ID),
+//! not an APID. Bytes that are not a valid ComCfg::Apid map to FW_PACKET_UNKNOWN; storing them as-is
+//! would fail ComCfg::Apid's assert.
+ComCfg::Apid::T apidFromLeadingBytes(FwPacketDescriptorType descriptor) {
+    return ComCfg::Apid::isValid(descriptor) ? static_cast<ComCfg::Apid::T>(descriptor)
+                                             : ComCfg::Apid::FW_PACKET_UNKNOWN;
+}
+}  // namespace
+
 // ----------------------------------------------------------------------
 // Construction, initialization, and destruction
 // ----------------------------------------------------------------------
