+        // Send in TX_BUF_SIZE chunks so buffers of any size are handled.
+        // Each chunk is staged in m_tx_buf and drained by the TX ISR.
+        // k_sem_take with a 200 ms timeout prevents the indefinite block
+        // that uart_poll_out() causes when the USB host stops reading.
+        const U8 *data = sendBuffer.getData();
+        U32 remaining = sendBuffer.getSize();
+
+        while (remaining > 0) {
+            U32 chunk = (remaining < TX_BUF_SIZE) ? remaining : TX_BUF_SIZE;
+            memcpy(m_tx_buf, data, chunk);
+            m_tx_pos = 0;
+            m_tx_len = chunk;
+
+            uart_irq_tx_enable(m_dev);
+
+            if (k_sem_take(&m_tx_sem, K_MSEC(200)) != 0) {
+                uart_irq_tx_disable(m_dev);
+                m_tx_len = 0;
+                m_tx_pos = 0;
+                return Drv::ByteStreamStatus::OTHER_ERROR;
+            }
+
+            data += chunk;
+            remaining -= chunk;
         }
         return Drv::ByteStreamStatus::OP_OK;
